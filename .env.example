# ==========================================
# JobFinder Pro - Environment Variables
# ==========================================

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-real-secret-for-production

# OAuth Providers (get these from developer consoles)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
AUTH_LINKEDIN_ID=your-linkedin-client-id
AUTH_LINKEDIN_SECRET=your-linkedin-client-secret

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobfinder
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/jobfinder
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# JSearch API (RapidAPI)
JSEARCH_API_KEY=your-rapidapi-key
